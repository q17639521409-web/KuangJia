<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>   <!-- 关键：启用打包 -->
    <Version>1.0.0</Version>         <!-- 建议同时指定版本号 -->
    <PackageId>FrameWebAPI.Service</PackageId>  <!-- 可选：指定包名 -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrameWebAPI.IService\FrameWebAPI.IService.csproj" />
    <ProjectReference Include="..\FrameWebAPI.Model\FrameWebAPI.Model.csproj" />
  </ItemGroup>

</Project>
